# Copy to .env and fill in. NEVER commit real values.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional: required to claim first-run owner setup on an internet-reachable gateway
EDITH_SETUP_KEY=
# Optional: 16+ random chars; enables encrypted API-key storage from the HUD
EDITH_SECRET_KEY=
# Set to 1 only when the gateway is served over HTTPS
EDITH_SECURE_COOKIE=0
# Local AI
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:3b
# Online providers (any subset). Leave empty to stay local-only.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
OPENROUTER_API_KEY=
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
